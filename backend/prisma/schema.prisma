// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses      Course[]
  lectures     Lecture[]
  flashcards   Flashcard[]
  quizzes      Quiz[]
  quizAnswers  QuizQuestion[]
  notes        Note[]

  @@map("users")
}

model Course {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  examDate    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lectures Lecture[]

  @@index([userId])
  @@map("courses")
}

model Lecture {
  id        String   @id @default(cuid())
  courseId  String
  userId    String
  title     String
  fileUrl   String
  rawText   String   @db.Text
  summary   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcards   Flashcard[]
  quizzes      Quiz[]
  notes        Note[]

  @@index([courseId])
  @@index([userId])
  @@map("lectures")
}

model Flashcard {
  id          String   @id @default(cuid())
  lectureId   String
  userId      String
  front       String   @db.Text
  back        String   @db.Text
  nextReview  DateTime @default(now())
  reviewCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lecture Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lectureId])
  @@index([userId])
  @@index([nextReview])
  @@map("flashcards")
}

model Quiz {
  id        String   @id @default(cuid())
  lectureId String
  userId    String
  score     Int
  total     Int
  takenAt   DateTime @default(now())
  createdAt DateTime @default(now())

  lecture  Lecture         @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]

  @@index([lectureId])
  @@index([userId])
  @@map("quizzes")
}

model QuizQuestion {
  id         String   @id @default(cuid())
  quizId     String
  userId     String
  question   String   @db.Text
  options    String   @db.Text // JSON array stored as text
  correct    String
  userAnswer String?
  isCorrect  Boolean
  createdAt  DateTime @default(now())

  quiz Quiz  @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([userId])
  @@map("quiz_questions")
}

model Note {
  id        String   @id @default(cuid())
  content   String   @db.Text
  lectureId String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lecture Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lectureId])
  @@index([userId])
  @@map("notes")
}
