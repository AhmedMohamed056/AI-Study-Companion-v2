generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  name                  String
  password              String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  commentsAuthored      Comment[]              @relation("author")
  courses               Course[]
  flashcards            Flashcard[]
  lectures              Lecture[]
  notes                 Note[]
  quizAnswers           QuizQuestion[]
  quizzes               Quiz[]
  sharedFlashcardSets   SharedFlashcardSet[]   @relation("creator")
  sharedQuizSets        SharedQuizSet[]        @relation("creator")
  sharedQuizWith        SharedQuizWith[]
  sharedFlashcardWith   SharedWith[]
  sentInvitations       StudyGroupInvitation[] @relation("sentBy")
  studyGroupMemberships StudyGroupMember[]
  studyGroupsOwned      StudyGroup[]           @relation("owner")
  studyPlan             StudyPlan?

  @@map("users")
}

model Course {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  examDate    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lectures    Lecture[]

  @@index([userId])
  @@map("courses")
}

model Lecture {
  id         String      @id @default(cuid())
  courseId   String
  userId     String
  title      String
  fileUrl    String
  rawText    String
  summary    String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  flashcards Flashcard[]
  course     Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes      Note[]
  quizzes    Quiz[]

  @@index([courseId])
  @@index([userId])
  @@map("lectures")
}

model Flashcard {
  id                  String                   @id @default(cuid())
  lectureId           String
  userId              String
  front               String
  back                String
  nextReview          DateTime                 @default(now())
  reviewCount         Int                      @default(0)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  ease                Float                    @default(2.5)
  interval            Float                    @default(1.0)
  lastReviewDate      DateTime?
  sourceCreatedAt     DateTime?
  sourceLectureTitle  String?
  comments            Comment[]                @relation("flashcardComments")
  lecture             Lecture                  @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sharedFlashcardSets SharedFlashcardSetItem[]

  @@index([lectureId])
  @@index([userId])
  @@index([nextReview])
  @@map("flashcards")
}

model Quiz {
  id                 String              @id @default(cuid())
  lectureId          String
  userId             String
  score              Int
  total              Int
  takenAt            DateTime            @default(now())
  createdAt          DateTime            @default(now())
  sourceCreatedAt    DateTime?
  sourceLectureTitle String?
  sharedQuizSetId    String?
  comments           Comment[]           @relation("quizComments")
  questions          QuizQuestion[]
  lecture            Lecture             @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sharedQuizSets     SharedQuizSetItem[]
  sharedQuizSet      SharedQuizSet?      @relation("recipientAttempts", fields: [sharedQuizSetId], references: [id], onDelete: SetNull)

  @@index([lectureId])
  @@index([userId])
  @@index([sharedQuizSetId])
  @@map("quizzes")
}

model QuizQuestion {
  id         String   @id @default(cuid())
  quizId     String
  userId     String
  question   String
  options    String
  correct    String
  userAnswer String?
  isCorrect  Boolean
  createdAt  DateTime @default(now())
  topic      String?
  quiz       Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([userId])
  @@map("quiz_questions")
}

model Note {
  id        String   @id @default(cuid())
  content   String
  lectureId String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lecture   Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lectureId])
  @@index([userId])
  @@map("notes")
}

model StudyGroup {
  id                  String                 @id @default(cuid())
  name                String
  description         String?
  createdBy           String
  sharedLectures      String                 @default("[]")
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  comments            Comment[]              @relation("groupComments")
  sharedFlashcardSets SharedFlashcardSet[]
  sharedQuizSets      SharedQuizSet[]
  invitations         StudyGroupInvitation[]
  members             StudyGroupMember[]
  owner               User                   @relation("owner", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([createdBy])
  @@map("study_groups")
}

model StudyGroupMember {
  id       String     @id @default(cuid())
  groupId  String
  userId   String
  role     String     @default("member")
  joinedAt DateTime   @default(now())
  group    StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@map("study_group_members")
}

model StudyGroupInvitation {
  id         String     @id @default(cuid())
  groupId    String
  email      String
  token      String     @unique @default(cuid())
  createdBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime   @default(now())
  sentBy     User       @relation("sentBy", fields: [createdBy], references: [id], onDelete: Cascade)
  group      StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, email])
  @@index([groupId])
  @@index([email])
  @@index([token])
  @@map("study_group_invitations")
}

model SharedFlashcardSet {
  id          String                   @id @default(cuid())
  title       String
  description String?
  createdBy   String
  isPublic    Boolean                  @default(false)
  shareToken  String                   @unique @default(cuid())
  groupId     String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  comments    Comment[]                @relation("sharedFlashcardComments")
  flashcards  SharedFlashcardSetItem[]
  creator     User                     @relation("creator", fields: [createdBy], references: [id], onDelete: Cascade)
  group       StudyGroup?              @relation(fields: [groupId], references: [id])
  sharedWith  SharedWith[]

  @@index([createdBy])
  @@index([groupId])
  @@map("shared_flashcard_sets")
}

model SharedFlashcardSetItem {
  id          String             @id @default(cuid())
  setId       String
  flashcardId String
  flashcard   Flashcard          @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  set         SharedFlashcardSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@unique([setId, flashcardId])
  @@index([setId])
  @@index([flashcardId])
  @@map("shared_flashcard_set_items")
}

model SharedQuizSet {
  id               String              @id @default(cuid())
  title            String
  description      String?
  createdBy        String
  isPublic         Boolean             @default(false)
  shareToken       String              @unique @default(cuid())
  groupId          String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  comments         Comment[]           @relation("sharedQuizComments")
  quizzes          SharedQuizSetItem[]
  recipientAttempts Quiz[]             @relation("recipientAttempts")
  creator          User                @relation("creator", fields: [createdBy], references: [id], onDelete: Cascade)
  group            StudyGroup?         @relation(fields: [groupId], references: [id])
  sharedWith       SharedQuizWith[]

  @@index([createdBy])
  @@index([groupId])
  @@map("shared_quiz_sets")
}

model SharedQuizSetItem {
  id     String        @id @default(cuid())
  setId  String
  quizId String
  quiz   Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  set    SharedQuizSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@unique([setId, quizId])
  @@index([setId])
  @@index([quizId])
  @@map("shared_quiz_set_items")
}

model SharedWith {
  id        String             @id @default(cuid())
  setId     String
  userId    String
  createdAt DateTime           @default(now())
  set       SharedFlashcardSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([setId, userId])
  @@index([setId])
  @@index([userId])
  @@map("shared_with")
}

model SharedQuizWith {
  id        String        @id @default(cuid())
  setId     String
  userId    String
  createdAt DateTime      @default(now())
  set       SharedQuizSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([setId, userId])
  @@index([setId])
  @@index([userId])
  @@map("shared_quiz_with")
}

model Comment {
  id                   String              @id @default(cuid())
  content              String
  authorId             String
  flashcardId          String?
  quizId               String?
  sharedFlashcardSetId String?
  sharedQuizSetId      String?
  studyGroupId         String?
  parentCommentId      String?
  isPinned             Boolean             @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  author               User                @relation("author", fields: [authorId], references: [id], onDelete: Cascade)
  flashcard            Flashcard?          @relation("flashcardComments", fields: [flashcardId], references: [id], onDelete: Cascade)
  parentComment        Comment?            @relation("replies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies              Comment[]           @relation("replies")
  quiz                 Quiz?               @relation("quizComments", fields: [quizId], references: [id], onDelete: Cascade)
  sharedFlashcardSet   SharedFlashcardSet? @relation("sharedFlashcardComments", fields: [sharedFlashcardSetId], references: [id], onDelete: Cascade)
  sharedQuizSet        SharedQuizSet?      @relation("sharedQuizComments", fields: [sharedQuizSetId], references: [id], onDelete: Cascade)
  studyGroup           StudyGroup?         @relation("groupComments", fields: [studyGroupId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([flashcardId])
  @@index([quizId])
  @@index([sharedFlashcardSetId])
  @@index([sharedQuizSetId])
  @@index([studyGroupId])
  @@index([parentCommentId])
  @@map("comments")
}

model StudyPlan {
  id                String   @id @default(cuid())
  userId            String   @unique
  examDate          DateTime
  plan              String
  dailyGoals        String
  selectedLectures  String   @default("[]")
  generatedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("study_plans")
}



